\u9999\u6E2F\u8282\u70B9 = url-test, \u9999\u6E2F, url = http://www.qualcomm.cn/generate_204, interval = 60, tolerance = 50, img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png
\u53F0\u6E7E\u8282\u70B9 = url-test, \u53F0\u6E7E, url = http://www.qualcomm.cn/generate_204, interval = 60, tolerance = 50, img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png
