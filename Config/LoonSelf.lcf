\u6CB9\u7BA1\u89C6\u9891 = select, \u8282\u70B9\u9009\u62E9, \u9999\u6E2F\u8282\u70B9, \u72EE\u57CE\u8282\u70B9, \u7F8E\u56FD\u8282\u70B9, \u53F0\u6E7E\u8282\u70B9, \u97E9\u56FD\u8282\u70B9, img-url = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
