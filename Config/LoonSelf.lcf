[Remote Filter]
\u9999\u6E2F = NameRegex, FilterKey = "^(?=.*((?i)\uD83C\uDDED\uD83C\uDDF0|\u9999\u6E2F|(\b(HK|HKG|Hong)(\d+)?\b)))(?!.*((?i)\u56DE\u56FD|\u6821\u56ED|\u6E38\u620F|\uD83C\uDFAE|(\b(GAME)\b))).*$"
\u53F0\u6E7E = NameRegex, FilterKey = "^(?=.*((?i)\uD83C\uDDF9\uD83C\uDDFC|\u53F0\u6E7E|(\b(TW|TWN|Tai|Taiwan)(\d+)?\b)))(?!.*((?i)\u56DE\u56FD|\u6821\u56ED|\u6E38\u620F|\uD83C\uDFAE|(\b(GAME)\b))).*$"
\u65E5\u672C = NameRegex, FilterKey = "^(?=.*((?i)\uD83C\uDDEF\uD83C\uDDF5|\u65E5\u672C|\u5DDD\u65E5|\u4E1C\u4EAC|\u5927\u962A|\u6CC9\u65E5|\u57FC\u7389|(\b(JP|JPN|Japan)(\d+)?\b)))(?!.*((?i)\u56DE\u56FD|\u6821\u56ED|\u6E38\u620F|\uD83C\uDFAE|(\b(GAME)\b))).*$"
\u97E9\u56FD = NameRegex, FilterKey = "^(?=.*((?i)\uD83C\uDDF0\uD83C\uDDF7|\u97E9\u56FD|\u97D3|\u9996\u5C14|(\b(KR|KOR|Korea)(\d+)?\b)))(?!.*((?i)\u56DE\u56FD|\u6821\u56ED|\u6E38\u620F|\uD83C\uDFAE|(\b(GAME)\b))).*$"
\u7F8E\u56FD = NameRegex, FilterKey = "^(?=.*((?i)\uD83C\uDDFA\uD83C\uDDF8|\u7F8E\u56FD|\u6CE2\u7279\u5170|\u8FBE\u62C9\u65AF|\u4FC4\u52D2\u5188|\u51E4\u51F0\u57CE|\u8D39\u5229\u8499|\u7845\u8C37|\u62C9\u65AF\u7EF4\u52A0\u65AF|\u6D1B\u6749\u77F6|\u5723\u4F55\u585E|\u5723\u514B\u62C9\u62C9|\u897F\u96C5\u56FE|\u829D\u52A0\u54E5|(\b(US|USA|United States)(\d+)?\b)))(?!.*((?i)\u56DE\u56FD|\u6821\u56ED|\u6E38\u620F|\uD83C\uDFAE|(\b(GAME)\b))).*$"
\u65B0\u52A0\u5761 = NameRegex, FilterKey = "^(?=.*((?i)\uD83C\uDDF8\uD83C\uDDEC|\u65B0\u52A0\u5761|\u72EE|(\b(SG|SGP|Singapore)(\d+)?\b)))(?!.*((?i)\u56DE\u56FD|\u6821\u56ED|\u6E38\u620F|\uD83C\uDFAE|(\b(GAME)\b))).*$"

